{
  "kind": "road",
  "seed": 17,
  "train_manifest": "data/parents/train/manifest.json",
  "validation_manifest": "data/parents/val/manifest.json",
  "model_options": {
    "history_steps": 41,
    "future_steps": 20,
    "width": 128,
    "layers": 2,
    "dropout": 0.1,
    "interval_seconds": 15.0,
    "maximum_anchor_gap_m": 25.0,
    "connection_tolerance_m": 0.001,
    "time_aware_graph": true,
    "beams": 8,
    "maximum_roads": 48,
    "proposal_mode": "endpoint",
    "include_fixed_routes": true,
    "initial_heading_guard": true
  },
  "training": {
    "steps": 800,
    "global_batch": 256,
    "micro_batch": 16,
    "learning_rate": 0.0003,
    "weight_decay": 0.01,
    "gradient_clip": 5.0,
    "z_weight": 1.0,
    "precision": "bf16",
    "validate_every": 100,
    "save_every": 100,
    "warmup_steps": 100
  },
  "geometry": "data/road_geometry_v10",
  "rank_teacher": "hybrid"
}
